# Sources and build inputs: the .vsix ships out/ and the generated grammar only.
src/**
tsconfig.json
out/**/*.map
syntaxes/vrl.tmLanguage.template.json
.vscodeignore

# wasm-pack scaffolding: the .wasm and its loader ship, the rest does not.
wasm/.gitignore
wasm/package.json
wasm/README.md
wasm/*.d.ts
