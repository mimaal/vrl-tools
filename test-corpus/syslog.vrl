# Synthetic syslog parser built on the public RFC 5424 shape.
# Exists to exercise the grammar and the checker, not to be a good parser.

parsed, err = parse_syslog(.message)
if err != null {
    .parse_error = err
    .tags = push(array(.tags) ?? [], "syslog_parse_failed")
} else {
    . = merge(., parsed)
}

# Every fallback goes through a type function: `.a ?? .b` does not compile,
# because reading a path never fails and the compiler says so (E651).
.severity = string(.severity) ?? "informational"
.host = string(.hostname) ?? string(.host) ?? string(%vector.host) ?? "unknown"
."@timestamp" = format_timestamp!(timestamp(.timestamp) ?? now(), format: "%+")

# A quoted segment holding characters an identifier cannot. Note the form:
# ."trace-id", not .["trace-id"] — brackets index arrays, they do not quote.
.service = string(.appname) ?? string(.app_name) ?? "unknown"
."trace-id" = string(.structured_data.trace.id) ?? ""

if !exists(.severity_number) {
    .severity_number = to_int(.severity) ?? 6
}

# Regex with escapes that must not terminate the literal early. The value is
# coerced because match() over an untyped field is a fallible predicate.
if match(to_string(.message) ?? "", r'^\[\d{4}-\d{2}-\d{2}\]\s+(?i)(warn|error)\b') {
    .level_hint = "elevated"
}

.raw = s'literal \n stays literal'
.ingested_at = t'2024-01-01T00:00:00Z'
.retention_days = 30
.sample_rate = 0.25
.offset = -1

for_each(object(.labels) ?? {}) -> |key, value| {
    if is_string(value) && length(key) > 0 {
        .normalised_labels = set!(object(.normalised_labels) ?? {}, [downcase(key)], value)
    }
}

del(.structured_data)
del(.message)
