{
  "name": "vrl-tools-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo root for vrl-tools. The publishable extension lives in editors/vscode.",
  "license": "MIT",
  "workspaces": [
    "editors/vscode"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen:grammar": "tsx scripts/gen-grammar.ts",
    "gen:icon": "python scripts/gen-icon.py",
    "gen:notices": "tsx scripts/gen-notices.ts",
    "compile": "npm run compile --workspace editors/vscode",
    "build:wasm": "wasm-pack build crates/vrl-check-wasm --release --target nodejs --out-dir ../../editors/vscode/wasm --out-name vrl_check_wasm",
    "build": "npm run gen:grammar && npm run gen:notices && npm run build:wasm && npm run compile",
    "watch": "npm run watch --workspace editors/vscode",
    "test:grammar": "tsx scripts/test-grammar.ts",
    "test:injection": "tsx scripts/test-injection.ts",
    "test:snippets": "tsx scripts/test-snippets.ts",
    "test:diagnostics": "tsx scripts/test-diagnostics.ts",
    "test:analysis": "tsx scripts/test-analysis.ts",
    "test": "npm run test:grammar && npm run test:injection && npm run test:snippets && npm run test:diagnostics && npm run test:analysis",
    "package": "npm run build && npm test && npm run package --workspace editors/vscode"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "tar": "^7.4.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "vrl": {
    "crateVersion": "0.35.0",
    "vectorRelease": "0.58.0"
  }
}
